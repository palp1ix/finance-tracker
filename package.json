{
  "name": "traty",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Траты — заметки о покупках с ИИ-аналитикой (local-first PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
